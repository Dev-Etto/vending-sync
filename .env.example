# Banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendingsync

# RabbitMQ
# Formato: amqp://usuario:senha@host:porta
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Autenticação JWT
# MUDE ESTE VALOR em produção! Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production

# Tempo de expiração do token JWT
# Formato: número + unidade (s=segundos, m=minutos, h=horas, d=dias)
JWT_EXPIRES_IN=7d

# Porta onde a API Fastify vai escutar
PORT=3001

# Ambiente de execução
# Valores válidos: development, test, production
NODE_ENV=development
